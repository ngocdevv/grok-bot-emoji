<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark, header-less window matching `userInterfaceStyle: "dark"` and the hidden status bar. -->
    <style name="Theme.GrokBotOrb" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/screen_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
</resources>
